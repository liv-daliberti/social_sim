# caches / build
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.env

# editor/recovery leftovers
*.orig
*.bak
*.unrecoverable

# logs (slurm + app)
*.log
*.out
*.err
logs/

# local venv / runtime scratch
.runtime/
.vizchk/
.venv*/

# heavy training artifacts (regenerable; not for deploy)
wandb/
reports/
*.arrow
# Activation tensors under mechanistic_probe are regenerable from the frozen
# task files and the pinned checkpoint commits; only their hashes are tracked.
**/mechanistic_probe/**/*.npz
# Mechanistic-transfer hidden states are multi-gigabyte, reproducible run
# products. Keep lightweight manifests and summaries eligible for review.
**/mechanistic_transfer/runs/**/*.npy

# GitHub publication boundary: large research payloads stay local and are
# distributed through the data release, while manifests/results stay tracked.
exp3_training_transfer/polymarket/raw/
exp1_prospective/data/raw_markets/*.jsonl
exp1_prospective/data/initial_forecasts/*.jsonl
exp1_prospective/data/initial_forecasts/_archive/
exp1_prospective/data/updated_forecasts/*.jsonl
exp1_prospective/data/daily_tracking/snapshot_*.jsonl
exp1_prospective/data/selected_markets/*.jsonl
exp1_prospective/data/selected_markets/_archive/
!exp1_prospective/data/selected_markets/diverse_2026-06-09.jsonl
exp1_prospective/data/_recovery_audit/
exp1_prospective/_archive/interim_results/
**/_archive/**/data/
**/_archive/**/*.pdf
**/_archive/**/*.png
**/_archive/**/*.webp
**/_archive/**/*.zip
# Local recovery copies of retired manuscript mirrors. Their committed history
# remains available in Git; the copies exist only to make consolidation reversible.
paper/_archive/retired_iclr_mirror_*/

# NFS silly-rename turds
.nfs*

# LaTeX build products (source, figures, PDFs, and checked-in .bbl stay visible)
*.aux
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
paper/ICLR_submission_*.zip

# Runtime locks held by probe allocations
**/mechanistic_probe/**/.probe.lock
**/mechanistic_probe/**/.relational_probe.lock

# Context-reversal raw inference stays local; small design/manifests/summaries remain reviewable.
exp1_prospective/context_reversal/responses/

# Supervised-pilot LoRA adapters and optimizer resume states are multi-gigabyte
# training products, reproducible from the frozen prompts and the pinned base
# checkpoint. Their train.jsonl logs, manifests and analyses stay tracked.
exp3_training_transfer/overnight_diagnostics_20260921/learnability/runs/**/resume.pt
exp3_training_transfer/overnight_diagnostics_20260921/learnability/runs/**/adapter/
# Publish-transaction backups keep before/after copies of the built manuscript.
# The PDFs duplicate paper/main.pdf; the transaction record and .tex/tables stay.
exp1_prospective/context_reversal/runs/**/backups/**/*.pdf

# Ledger mutex files are process-local, not accounting records.
exp1_prospective/context_reversal/runs/**/ledger.json.lock
