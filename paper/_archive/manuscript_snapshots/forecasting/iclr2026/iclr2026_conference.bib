@article{kojima2022large,
  title={Large language models are zero-shot reasoners},
  author={Kojima, Takeshi and Gu, Shixiang Shane and Reid, Machel and Matsuo, Yutaka and Iwasawa, Yusuke},
  journal={Advances in neural information processing systems},
  volume={35},
  pages={22199--22213},
  year={2022}
}

@inproceedings{yasunaga2024large,
  title={Large language models as analogical reasoners},
  author={Yasunaga, Michihiro and Chen, Xinyun and Li, Yujia and Pasupat, Panupong and Leskovec, Jure and Liang, Percy and Chi, Ed H and Zhou, Denny},
  booktitle={International Conference on Learning Representations},
  volume={2024},
  pages={17019--17045},
  year={2024}
}
Introduces analogical prompting, in which a model self-generates relevant exemplars
by analogy to patterns internalized during training, rather than retrieving them, to
guide reasoning. Establishes that apparent competence can stem from analogical
generalization; supports ``broad analogical induction over patterns encoded during
training'' as a candidate mechanism (it demonstrates the mechanism exists, not that
it explains forecasting accuracy).


@inproceedings{khandelwal2020generalization,
  title={Generalization through Memorization: Nearest Neighbor Language Models},
  author={Khandelwal, Urvashi and Levy, Omer and Jurafsky, Dan and Zettlemoyer, Luke and Lewis, Mike},
  booktitle={International Conference on Learning Representations (ICLR)}, year={2020}
}
The kNN-LM augments a pretrained LM by retrieving nearest-neighbor contexts from a datastore in
embedding space and interpolating their continuations, which is especially helpful
for rare, long-tail patterns. The most literal instance of ``retrieval of similar
cases.''



@article{lewis2020retrieval,
  title={Retrieval-Augmented Generation for Knowledge-Intensive {NLP} Tasks},
  author={Lewis, Patrick and Perez, Ethan and Piktus, Aleksandra and Petroni, Fabio and Karpukhin, Vladimir and Goyal, Naman and K{\"u}ttler, Heinrich and Lewis, Mike and Yih, Wen-tau and Rockt{\"a}schel, Tim and Riedel, Sebastian and Kiela, Douwe},
  journal={Advances in Neural Information Processing Systems (NeurIPS)}, volume={33},
  pages={9459--9474}, year={2020}
}
Retrieval-augmented generation couples a
parametric generator with non-parametric retrieval over a document index,
conditioning each output on retrieved passages. Supports ``retrieval of similar
cases'' as the general retrieval-augmentation paradigm.

@book{tetlock2005expert,
  title={Expert Political Judgment: How Good Is It? How Can We Know?},
  author={Tetlock, Philip E.}, publisher={Princeton University Press}, year={2005}
}
A longitudinal study of expert political forecasts finding
them frequently poorly calibrated, with flexible, self-critical (``fox'') forecasters
outperforming those committed to a single grand theory (``hedgehog''). Supports the
framing of judgmental forecasting as demanding and skill-differentiated.

@inproceedings{zou2022forecasting,
  title={Forecasting Future World Events with Neural Networks},
  author={Zou, Andy and Xiao, Tristan and Jia, Ryan and Kwon, Joe and Mazeika, Mantas and Li, Richard and Song, Dawn and Steinhardt, Jacob and Evans, Owain and Hendrycks, Dan},
  booktitle={Advances in Neural Information Processing Systems (NeurIPS), Datasets and Benchmarks Track}, year={2022}
}
Introduces Autocast, a benchmark of
forecasting-tournament questions paired with a date-organized news corpus that permits
leakage-free evaluation of LM forecasts against human-crowd trajectories. Establishes
the LM-forecasting research program.

@article{ha2018world,
  title={World Models}, author={Ha, David and Schmidhuber, J{\"u}rgen},
  journal={arXiv preprint arXiv:1803.10122}, year={2018}
}
\textit{Ha \& Schmidhuber (2018).} Learns a compact generative world model---a VAE
encoder plus a recurrent latent-dynamics predictor---of an environment; a controller
trained entirely inside the model's rollouts transfers back to the real environment.
The canonical ML instantiation of a learned world model.

@article{lecun2022path,
  title={A Path Towards Autonomous Machine Intelligence}, author={LeCun, Yann},
  journal={OpenReview}, year={2022}
}
\textit{LeCun (2022).} Position paper arguing that autonomous intelligence requires
predictive world models operating in abstract representation space (JEPA), rather than
pure pattern matching. Situates predictive world models as central to machine
intelligence.

@inproceedings{ribeiro2020beyond,
  title={Beyond Accuracy: Behavioral Testing of {NLP} Models with {CheckList}},
  author={Ribeiro, Marco Tulio and Wu, Tongshuang and Guestrin, Carlos and Singh, Sameer},
  booktitle={Proceedings of the 58th Annual Meeting of the Association for Computational Linguistics (ACL)},
  pages={4902--4912}, year={2020}
}
CheckList: behavioral testing of
NLP models via minimum-functionality, invariance, and directional-expectation tests,
motivated by the observation that held-out accuracy overstates competence. Its
directional-expectation test---a perturbation should shift predictions in a specified
direction---is the conceptual template for our directional evidence checks. Supports
``evaluation beyond accuracy.''

@article{elazar2021measuring,
  title={Measuring and Improving Consistency in Pretrained Language Models},
  author={Elazar, Yanai and Kassner, Nora and Ravfogel, Shauli and Ravichander, Abhilasha and Hovy, Eduard and Sch{\"u}tze, Hinrich and Goldberg, Yoav},
  journal={Transactions of the Association for Computational Linguistics (TACL)}, volume={9}, year={2021}
}
\textit{Elazar et al.\ (2021), TACL.} Shows pretrained LMs often produce contradictory
answers to meaning-equivalent queries and introduces a resource (ParaRel) and metric for
measuring such inconsistency. We adapt this consistency lens from cross-input agreement
to within-case agreement among an agent's hypotheses, updates, and forecast.

@article{brier1950verification,
  title={Verification of Forecasts Expressed in Terms of Probability},
  author={Brier, Glenn W.}, journal={Monthly Weather Review}, volume={78}, number={1}, pages={1--3}, year={1950}
}
\textit{Brier (1950), Monthly Weather Review.} Defines the Brier score for verifying
probabilistic forecasts against realized outcomes---the foundational calibration
metric. Supports ``calibration'' as a standard forecasting criterion.

@article{dawid1982well,
  title={The Well-Calibrated Bayesian}, author={Dawid, A. Philip},
  journal={Journal of the American Statistical Association}, volume={77}, number={379},
  pages={605--610}, year={1982}
}
\textit{Dawid (1982), JASA.} Formalizes calibration as empirical-frequency matching---a
forecaster is well calibrated if, among events assigned probability $p$, the long-run
fraction that occur is $p$---and shows that a coherent Bayesian expects to be well
calibrated. Anchors the definition of calibration (and connects it to coherence).

@inproceedings{turpin2023language,
  title={Language Models Don't Always Say What They Think: Unfaithful Explanations in Chain-of-Thought Prompting},
  author={Turpin, Miles and Michael, Julian and Perez, Ethan and Bowman, Samuel R.},
  booktitle={Advances in Neural Information Processing Systems (NeurIPS)},
  volume={36}, pages={74952--74965}, year={2023}
}
\textit{Turpin, Michael, Perez \& Bowman (2023), NeurIPS.} Shows that chain-of-thought
explanations can systematically misrepresent the true cause of a model's prediction: when
biased toward a predetermined answer, models produce plausible rationales for it without
acknowledging the bias. Motivates our concern that an agent may rationalize a fixed
forecast after the fact rather than letting its stated reasoning govern it.

