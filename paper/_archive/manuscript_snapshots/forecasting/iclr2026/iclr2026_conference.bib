@article{mellers2014psychological,
  title={Psychological strategies for winning a geopolitical forecasting tournament},
  author={Mellers, Barbara and Ungar, Lyle and Baron, Jonathan and Ramos, Jaime and Gurcay, Burcu and Fincher, Katrina and Scott, Sydney E and Moore, Don and Atanasov, Pavel and Swift, Samuel A and others},
  journal={Psychological science},
  volume={25},
  number={5},
  pages={1106--1115},
  year={2014},
  publisher={Sage Publications Sage CA: Los Angeles, CA}
}
Reports the
Good Judgment Project geopolitical forecasting tournament and identifies
psychological strategies (e.g., probabilistic granularity and frequent updating)
that improve accuracy on real-world geopolitical questions. Supports geopolitics /
policy and the move from noisy evidence to calibrated probabilities.

@book{tetlock2016superforecasting,
  title={Superforecasting: The art and science of prediction},
  author={Tetlock, Philip E and Gardner, Dan},
  year={2016},
  publisher={Random House}
}
Documents that trained human
forecasters produce well-calibrated probability judgments on geopolitical,
political, and policy questions, attributing success to decomposition, base-rate
use, and incremental belief updating. Supports the elections / policy / geopolitics
examples and ``calibrated beliefs.''

@article{tenenbaum2006theory,
  title={Theory-based Bayesian models of inductive learning and reasoning},
  author={Tenenbaum, Joshua B and Griffiths, Thomas L and Kemp, Charles},
  journal={Trends in cognitive sciences},
  volume={10},
  number={7},
  pages={309--318},
  year={2006},
  publisher={Elsevier}
}

\textit{Tenenbaum, Griffiths \& Kemp (2006), TiCS 10(7):309--318.} Argues that human
induction requires both statistical learning and structured domain knowledge, and
formalizes this as Bayesian inference over structured representations: a domain
theory generates a constrained hypothesis space with associated priors and
likelihoods. Supports ``generalizing from sparse, noisy observations to infer latent
\dots mechanisms.''


@article{griffiths2010probabilistic,
  title={Probabilistic models of cognition: Exploring representations and inductive biases},
  author={Griffiths, Thomas L and Chater, Nick and Kemp, Charles and Perfors, Amy and Tenenbaum, Joshua B},
  journal={Trends in cognitive sciences},
  volume={14},
  number={8},
  pages={357--364},
  year={2010},
  publisher={Elsevier}
}

Frames cognition as reverse-engineering the mind's solutions to inductive problems;
the probabilistic approach begins from ideal (Bayesian) solutions and studies how
structured representations and inductive biases determine what is generalized.
Supports the ``generalizing from sparse, noisy observations'' framing.

@article{tenenbaum2011mind,
  title={How to grow a mind: Statistics, structure, and abstraction},
  author={Tenenbaum, Joshua B. and Kemp, Charles and Griffiths, Thomas L. and Goodman, Noah D.},
  journal={Science}, volume={331}, number={6022}, pages={1279--1285}, year={2011}
}
States most directly that abstract knowledge is encoded as a probabilistic generative
model of the causal processes producing observations, including latent variables
whose hidden state---once inferred---supports prediction and action. This is the
closest match to ``infer latent states \dots and then use those inferred models to
predict how the world may evolve.''


@article{lawrence2006judgmental,
  title={Judgmental forecasting: A review of progress over the last 25 years},
  author={Lawrence, Michael and Goodwin, Paul and O'Connor, Marcus and {\"O}nkal, Dilek},
  journal={International Journal of Forecasting}, volume={22}, number={3},
  pages={493--518}, year={2006}
}
A 25-year review of judgmental forecasting spanning business
demand and new-product settings, concluding that human judgment is an indispensable
but bias-prone component of forecasting. Supports the ``product launches'' example
and the framing of judgmental forecasting as a recognized, demanding practice.

